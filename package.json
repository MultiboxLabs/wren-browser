{
  "name": "wren-browser",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "bun run scripts/dev.ts",
    "build": "bun run scripts/build.ts",
    "start": "bun run build --run",
    "publish": "bun run scripts/publish.ts",
    "dmg": "bun run scripts/dmg.ts",
    "check": "bun run scripts/cn-tables.ts && bun run scripts/check-chrome-pages.ts && bun run scripts/check-compiler.ts && cargo check && cargo clippy --all-targets && tsc",
    "test:cargo": "cargo test",
    "test:drags": "bun run scripts/drags.ts",
    "test:perf": "bun run scripts/perf.ts",
    "sync-bangs": "bun run scripts/sync-bangs.ts",
    "sync-ublock": "bun run scripts/sync-ublock.ts",
    "format": "prettier --write . && cargo fmt"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@types/bun": "latest",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "oxc-transform-react": "^0.158.0",
    "prettier": "^3.10.1",
    "tailwindcss": "^4.3.5",
    "typescript": "7",
    "vite": "^8.3.8"
  },
  "dependencies": {
    "cn": "^0.5.2",
    "lucide-react": "^1.72.0",
    "motion": "^14.14.0",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  }
}
