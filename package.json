{
  "name": "wren-browser",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "bun run scripts/dev.ts",
    "build": "bun run scripts/build.ts",
    "start": "bun run build --run",
    "publish": "bun run scripts/publish.ts",
    "dmg": "bun run scripts/dmg.ts",
    "perf": "bun run scripts/perf.ts",
    "check": "bun run scripts/cn-tables.ts && bun run scripts/check-chrome-pages.ts && cargo check && cargo clippy --all-targets && tsc",
    "sync-bangs": "bun run scripts/sync-bangs.ts",
    "sync-ublock": "bun run scripts/sync-ublock.ts",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/bun": "latest",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "oxc-transform-react": "^0.154.0",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.3.3",
    "typescript": "5",
    "vite": "^8.3.4"
  },
  "dependencies": {
    "cn": "^0.5.0",
    "lucide-react": "^1.57.0",
    "motion": "^14.3.0",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  }
}
