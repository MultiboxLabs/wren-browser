{
  "manifest_version": 3,
  "name": "Wren Components",
  "version": "0.1.0",
  "description": "Code Wren runs inside pages, which the user does not manage.",
  "key": "",
  "permissions": ["nativeMessaging"],
  "background": { "service_worker": "background.js", "type": "module" },
  "content_scripts": [
    {
      "matches": ["https://chromewebstore.google.com/*"],
      "js": ["chrome-web-store.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "chrome://settings/*",
        "chrome://extensions/*",
        "chrome://downloads/*",
        "chrome://history/*",
        "chrome://bookmarks/*",
        "chrome://flags/*",
        "chrome://version/*",
        "chrome://password-manager/*",
        "chrome://certificate-manager/*",
        "chrome://management/*",
        "chrome://discards/*",
        "chrome://apps/*",
        "chrome://app-settings/*",
        "chrome://support-tool/*",
        "chrome://updater/*",
        "chrome://iwa-dev/*",
        "chrome://on-device-internals/*",
        "chrome://suggest-internals/*",
        "chrome://user-education-internals/*",
        "chrome://color-pipeline-internals/*",
        "chrome://autofill-ml-internals/*"
      ],
      "css": ["chrome-pages/theme.css"],
      "js": ["chrome-pages/components.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["chrome://version/*"],
      "css": ["chrome-pages/version.css"],
      "run_at": "document_start"
    }
  ]
}
